<idea-plugin>
    <id>com.github.gitversiontracker</id>
    <name>Git Branch Version Tracker</name>
    <vendor url="https://github.com/parkcg123/gitflow_version_check">parkcg123</vendor>

    <description><![CDATA[
    <h3>Git Branch Version Tracker</h3>
    <p>Tracks and inspects merge commits for <code>hotfix</code>, <code>release</code>, and <code>feature</code> branches from Git commit history.</p>
    <ul>
      <li>Displays latest branch version on the bottom-right status bar.</li>
      <li>Click status bar widget for quick version list and one-click copy.</li>
      <li>Customizable regex pattern with persistent settings support.</li>
      <li>Detailed table ToolWindow located at the bottom bar.</li>
      <li>Filter by branch type (ALL, hotfix, release, feature).</li>
      <li>Runs asynchronously in the background using native IntelliJ Git API.</li>
    </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>Git4Idea</depends>

    <extensions defaultExtensionNs="com.intellij">
        <projectService serviceImplementation="com.github.gitversiontracker.GitVersionTrackerSettings"/>
        <statusBarWidgetFactory id="GitVersionTrackerWidget"
                                implementation="com.github.gitversiontracker.GitVersionTrackerWidgetFactory"/>
        <toolWindow id="GitFlow Versions"
                    anchor="bottom"
                    factoryClass="com.github.gitversiontracker.GitVersionTrackerToolWindowFactory"
                    icon="AllIcons.Nodes.Tag"/>
        <notificationGroup id="Git Version Tracker Notifications"
                           displayType="BALLOON"/>
    </extensions>
</idea-plugin>
